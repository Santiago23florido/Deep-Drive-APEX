<?xml version="1.0"?>
<robot name="rc_car" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="lidar_noise_std" default="0.0"/>
  <xacro:arg name="imu_gyro_noise_stddev_rps" default="0.002"/>
  <xacro:arg name="imu_accel_noise_stddev_mps2" default="0.02"/>
  <xacro:property name="lidar_noise_std" value="$(arg lidar_noise_std)"/>
  <xacro:property name="imu_gyro_noise_stddev_rps" value="$(arg imu_gyro_noise_stddev_rps)"/>
  <xacro:property name="imu_accel_noise_stddev_mps2" value="$(arg imu_accel_noise_stddev_mps2)"/>

  <!-- Real2sim options (tools/pose_dataset/config/sensors.yaml, backend
       gazebo_native). The defaults keep the historical rigid car and sensors. -->
  <!-- Sprung body on roll / pitch spring-damper joints; the LiDAR, IMU and
       camera ride on it, so the scan plane and the IMU tilt physically. -->
  <xacro:arg name="suspension" default="false"/>
  <xacro:property name="suspension" value="$(arg suspension)"/>
  <!-- gpu_lidar used as the geometry source of the rolling-scan model. -->
  <xacro:arg name="lidar_update_rate" default="12"/>
  <xacro:arg name="lidar_samples" default="360"/>
  <xacro:arg name="lidar_range_min" default="0.05"/>
  <xacro:arg name="lidar_range_max" default="12.0"/>
  <xacro:arg name="lidar_range_resolution" default="0.01"/>
  <!-- IMU: rate and Gazebo's native noise model (per-sample white std, turn-on
       bias, Gauss-Markov bias) on each axis; "x y z" strings. -->
  <xacro:arg name="imu_update_rate" default="120"/>
  <xacro:arg name="imu_gyro_white_std" default=""/>
  <xacro:arg name="imu_gyro_bias_std" default="0 0 0"/>
  <xacro:arg name="imu_gyro_dynamic_bias_std" default="0 0 0"/>
  <xacro:arg name="imu_gyro_dynamic_bias_tau" default="100 100 100"/>
  <xacro:arg name="imu_accel_white_std" default=""/>
  <xacro:arg name="imu_accel_bias_std" default="0 0 0"/>
  <xacro:arg name="imu_accel_dynamic_bias_std" default="0 0 0"/>
  <xacro:arg name="imu_accel_dynamic_bias_tau" default="100 100 100"/>
  <!-- Second, noise-free IMU on the same mount (topic imu_clean_topic): its
       difference with the noisy one is the exact noise + bias (dataset labels). -->
  <xacro:arg name="imu_clean_reference" default="false"/>
  <xacro:arg name="imu_clean_topic" default="/apex/sim/imu_clean"/>
  <xacro:arg name="camera" default="true"/>
  <!-- True sensor mounts in base_link ("x y z" / "roll pitch yaw" [rad]);
       empty keeps the nominal mounts. The dataset draws them per run
       (nominal + calibration error), like a real car differs from its
       nominal calibration. -->
  <xacro:arg name="lidar_xyz" default=""/>
  <xacro:arg name="lidar_rpy" default="0 0 0"/>
  <xacro:arg name="imu_xyz" default=""/>
  <xacro:arg name="imu_rpy" default="0 0 0"/>
  <!-- Basic dimensions -->
  <xacro:property name="chassis_length" value="0.46"/>
  <xacro:property name="chassis_width" value="0.28"/>
  <xacro:property name="chassis_height" value="0.10"/>
  <xacro:property name="chassis_clearance" value="0.03"/>
  <xacro:property name="wheel_radius" value="0.06"/>
  <xacro:property name="wheel_thickness" value="0.03"/>
  <xacro:property name="wheelbase_m" value="0.30"/>
  <xacro:property name="rear_axle_offset_x" value="-0.15"/>
  <xacro:property name="front_axle_offset_x" value="${rear_axle_offset_x + wheelbase_m}"/>
  <xacro:property name="steering_limit_rad" value="0.3141592654"/>
  <xacro:property name="lidar_offset_x" value="0.18"/>
  <xacro:property name="lidar_offset_z" value="0.12"/>

  <!-- Placement helpers -->
  <xacro:property name="wheel_base_x" value="${front_axle_offset_x}"/>
  <xacro:property name="wheel_track_y" value="${chassis_width / 2.0 + wheel_thickness / 2.0 - 0.01}"/>
  <xacro:property name="axle_height" value="${wheel_radius}"/>

  <!-- Mass and inertia approximations -->
  <xacro:property name="chassis_mass" value="3.0"/>
  <xacro:property name="wheel_mass" value="0.25"/>
  <xacro:property name="steer_mass" value="0.05"/>

  <!-- Suspension (only with suspension:=true). The chassis mass is split into
       an unsprung frame (base_link, carries the wheels) and the sprung body
       (chassis + LiDAR, IMU and camera mounts). Targets from
       tools/pose_dataset/config/vehicle.yaml (body_dynamics): 3.5 Hz sprung
       mode, zeta 0.45, 3 deg of roll per g of lateral and 2 deg of pitch per
       g of longitudinal acceleration. For a pivot at height h below the
       sprung centre of mass (m, I_cm):
         gain = m h / (I_p w^2),  k = I_p w^2 + m g h,  c = 2 zeta I_p w,
         I_p = I_cm + m h^2.
       With the merged sprung body of this model (m 2.83 kg, CoM at
       x 0.0078 m, z 0.0829 m, Ixx 0.0209, Iyy 0.0555 kg m^2): roll pivot
       0.0201 m and pitch pivot 0.0360 m below the CoM, the pitch pivot
       directly under it (level at rest). Recompute when masses or mounts
       change; tests/test_suspension.py checks the response. -->
  <xacro:property name="unsprung_mass" value="0.3"/>
  <xacro:property name="sprung_mass" value="${chassis_mass - unsprung_mass}"/>
  <xacro:property name="sprung_com_z" value="${chassis_height / 2.0 + chassis_clearance}"/>
  <xacro:property name="roll_pivot_z" value="0.0628"/>
  <xacro:property name="pitch_pivot_x" value="0.0078"/>
  <xacro:property name="pitch_pivot_z" value="0.0469"/>
  <xacro:property name="roll_stiffness" value="11.23"/>
  <xacro:property name="roll_damping" value="0.437"/>
  <xacro:property name="pitch_stiffness" value="29.59"/>
  <xacro:property name="pitch_damping" value="1.170"/>
  <xacro:property name="suspension_limit_rad" value="0.12"/>

  <xacro:property name="chassis_ixx" value="${chassis_mass / 12.0 * (chassis_height*chassis_height + chassis_width*chassis_width)}"/>
  <xacro:property name="chassis_iyy" value="${chassis_mass / 12.0 * (chassis_length*chassis_length + chassis_height*chassis_height)}"/>
  <xacro:property name="chassis_izz" value="${chassis_mass / 12.0 * (chassis_length*chassis_length + chassis_width*chassis_width)}"/>

  <xacro:property name="wheel_ixx" value="${wheel_mass / 12.0 * (3*wheel_radius*wheel_radius + wheel_thickness*wheel_thickness)}"/>
  <xacro:property name="wheel_iyy" value="${wheel_ixx}"/>
  <xacro:property name="wheel_izz" value="${0.5 * wheel_mass * wheel_radius * wheel_radius}"/>

  <!-- Materials -->
  <material name="chassis_grey">
    <color rgba="0.27 0.27 0.3 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <xacro:macro name="wheel" params="name parent xyz">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_ixx}" ixy="0.0" ixz="0.0" iyy="${wheel_iyy}" iyz="0.0" izz="${wheel_izz}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="1.5708 0 0"/>
      <axis xyz="0 0 -1"/>
    </joint>
    <gazebo reference="${name}">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>80000.0</kp>
      <kd>20.0</kd>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="steered_wheel" params="name parent xyz">
    <link name="${name}_steer">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${steer_mass}"/>
        <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.01" length="0.04"/>
        </geometry>
        <material name="chassis_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.01" length="0.04"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_steer_joint" type="revolute">
      <parent link="${parent}"/>
      <child link="${name}_steer"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-${steering_limit_rad}" upper="${steering_limit_rad}" effort="10.0" velocity="3.5"/>
    </joint>
    <xacro:wheel name="${name}" parent="${name}_steer" xyz="0 0 0"/>
  </xacro:macro>

  <xacro:if value="${not suspension}">
    <link name="base_link">
      <inertial>
        <origin xyz="0 0 ${chassis_height / 2.0 + chassis_clearance}" rpy="0 0 0"/>
        <mass value="${chassis_mass}"/>
        <inertia ixx="${chassis_ixx}" ixy="0.0" ixz="0.0" iyy="${chassis_iyy}" iyz="0.0" izz="${chassis_izz}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${chassis_height / 2.0 + chassis_clearance}" rpy="0 0 0"/>
        <geometry>
          <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
        </geometry>
        <material name="chassis_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${chassis_height / 2.0 + chassis_clearance}" rpy="0 0 0"/>
        <geometry>
          <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
        </geometry>
      </collision>
    </link>
  </xacro:if>

  <xacro:if value="${suspension}">
    <link name="base_link">
      <inertial>
        <origin xyz="0 0 ${axle_height}" rpy="0 0 0"/>
        <mass value="${unsprung_mass}"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.004"/>
      </inertial>
    </link>
    <link name="suspension_roll_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.01"/>
        <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
      </inertial>
    </link>
    <joint name="suspension_roll_joint" type="revolute">
      <parent link="base_link"/>
      <child link="suspension_roll_link"/>
      <origin xyz="0 0 ${roll_pivot_z}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-${suspension_limit_rad}" upper="${suspension_limit_rad}" effort="100.0" velocity="10.0"/>
      <dynamics damping="${roll_damping}" friction="0.0"/>
    </joint>
    <link name="sprung_body">
      <inertial>
        <origin xyz="${-pitch_pivot_x} 0 ${sprung_com_z - pitch_pivot_z}" rpy="0 0 0"/>
        <mass value="${sprung_mass}"/>
        <inertia ixx="${sprung_mass / 12.0 * (chassis_height*chassis_height + chassis_width*chassis_width)}" ixy="0.0" ixz="0.0"
                 iyy="${sprung_mass / 12.0 * (chassis_length*chassis_length + chassis_height*chassis_height)}" iyz="0.0"
                 izz="${sprung_mass / 12.0 * (chassis_length*chassis_length + chassis_width*chassis_width)}"/>
      </inertial>
      <visual>
        <origin xyz="${-pitch_pivot_x} 0 ${sprung_com_z - pitch_pivot_z}" rpy="0 0 0"/>
        <geometry>
          <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
        </geometry>
        <material name="chassis_grey"/>
      </visual>
      <collision>
        <origin xyz="${-pitch_pivot_x} 0 ${sprung_com_z - pitch_pivot_z}" rpy="0 0 0"/>
        <geometry>
          <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
        </geometry>
      </collision>
    </link>
    <joint name="suspension_pitch_joint" type="revolute">
      <parent link="suspension_roll_link"/>
      <child link="sprung_body"/>
      <origin xyz="${pitch_pivot_x} 0 ${pitch_pivot_z - roll_pivot_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-${suspension_limit_rad}" upper="${suspension_limit_rad}" effort="100.0" velocity="10.0"/>
      <dynamics damping="${pitch_damping}" friction="0.0"/>
    </joint>
    <gazebo reference="suspension_roll_joint">
      <springStiffness>${roll_stiffness}</springStiffness>
      <springReference>0.0</springReference>
    </gazebo>
    <gazebo reference="suspension_pitch_joint">
      <springStiffness>${pitch_stiffness}</springStiffness>
      <springReference>0.0</springReference>
    </gazebo>
  </xacro:if>

  <!-- Sensors ride on the sprung body when there is one; their offsets stay
       the base_link mount of the real car. -->
  <xacro:property name="sensor_parent" value="${'sprung_body' if suspension else 'base_link'}"/>
  <xacro:property name="sensor_dx" value="${pitch_pivot_x if suspension else 0.0}"/>
  <xacro:property name="sensor_dz" value="${pitch_pivot_z if suspension else 0.0}"/>
  <xacro:property name="lidar_mount" value="${[float(v) for v in ('$(arg lidar_xyz)'.split() or [lidar_offset_x, 0.0, lidar_offset_z])]}"/>
  <xacro:property name="imu_mount" value="${[float(v) for v in ('$(arg imu_xyz)'.split() or [0.02, 0.0, chassis_height / 2.0 + 0.03])]}"/>

  <link name="rear_axle">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.00002" ixy="0.0" ixz="0.0" iyy="0.00002" iyz="0.0" izz="0.00002"/>
    </inertial>
  </link>

  <link name="laser">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.03"/>
      </geometry>
      <material name="chassis_grey"/>
    </visual>
  </link>

  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.02 0.01"/>
      </geometry>
      <material name="chassis_grey"/>
    </visual>
  </link>

  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.02 0.02"/>
      </geometry>
      <material name="chassis_grey"/>
    </visual>
  </link>

  <joint name="rear_axle_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_axle"/>
    <origin xyz="${rear_axle_offset_x} 0 ${axle_height}" rpy="0 0 0"/>
  </joint>

  <joint name="lidar_joint" type="fixed">
    <parent link="${sensor_parent}"/>
    <child link="laser"/>
    <origin xyz="${lidar_mount[0] - sensor_dx} ${lidar_mount[1]} ${lidar_mount[2] - sensor_dz}" rpy="$(arg lidar_rpy)"/>
  </joint>

  <joint name="imu_joint" type="fixed">
    <parent link="${sensor_parent}"/>
    <child link="imu_link"/>
    <!-- Match the current real APEX mount: sensor X points forward and sensor
         Y points left, matching the vehicle base_link convention. -->
    <origin xyz="${imu_mount[0] - sensor_dx} ${imu_mount[1]} ${imu_mount[2] - sensor_dz}" rpy="$(arg imu_rpy)"/>
  </joint>

  <joint name="camera_joint" type="fixed">
    <parent link="${sensor_parent}"/>
    <child link="camera_link"/>
    <origin xyz="${0.25 - sensor_dx} 0.0 ${0.20 - sensor_dz}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="laser">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>$(arg lidar_update_rate)</update_rate>
      <visualize>true</visualize>
      <topic>/apex/sim/scan</topic>
      <!-- Gazebo modern uses gz_frame_id for sensor messages. Keep the ideal
           scan anchored to the URDF laser link so slam_toolbox can use the
           existing base_link -> laser TF from robot_state_publisher instead of
           a hand-written sensor TF. -->
      <gz_frame_id>laser</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>$(arg lidar_samples)</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>$(arg lidar_range_min)</min>
          <max>$(arg lidar_range_max)</max>
          <resolution>$(arg lidar_range_resolution)</resolution>
        </range>
        <!-- Optional light LiDAR noise for robustness sweeps. Default stays at
             zero so the baseline ideal scan remains perfectly reproducible. -->
        <noise type="gaussian">
          <mean>0.0</mean>
          <stddev>${lidar_noise_std}</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Per-axis native noise: the historical scalar args apply when the
       "x y z" strings are empty. -->
  <xacro:property name="gyro_white" value="${[float(v) for v in ('$(arg imu_gyro_white_std)'.split() or [imu_gyro_noise_stddev_rps] * 3)]}"/>
  <xacro:property name="gyro_bias" value="${[float(v) for v in '$(arg imu_gyro_bias_std)'.split()]}"/>
  <xacro:property name="gyro_dyn" value="${[float(v) for v in '$(arg imu_gyro_dynamic_bias_std)'.split()]}"/>
  <xacro:property name="gyro_tau" value="${[float(v) for v in '$(arg imu_gyro_dynamic_bias_tau)'.split()]}"/>
  <xacro:property name="accel_white" value="${[float(v) for v in ('$(arg imu_accel_white_std)'.split() or [imu_accel_noise_stddev_mps2] * 3)]}"/>
  <xacro:property name="accel_bias" value="${[float(v) for v in '$(arg imu_accel_bias_std)'.split()]}"/>
  <xacro:property name="accel_dyn" value="${[float(v) for v in '$(arg imu_accel_dynamic_bias_std)'.split()]}"/>
  <xacro:property name="accel_tau" value="${[float(v) for v in '$(arg imu_accel_dynamic_bias_tau)'.split()]}"/>

  <xacro:macro name="imu_noise" params="axis white bias dyn tc">
    <xacro:element xacro:name="${axis}">
      <noise type="gaussian">
        <mean>0.0</mean>
        <stddev>${white}</stddev>
        <bias_mean>0.0</bias_mean>
        <bias_stddev>${bias}</bias_stddev>
        <dynamic_bias_stddev>${dyn}</dynamic_bias_stddev>
        <dynamic_bias_correlation_time>${tc}</dynamic_bias_correlation_time>
      </noise>
    </xacro:element>
  </xacro:macro>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>$(arg imu_update_rate)</update_rate>
      <topic>/apex/sim/imu</topic>
      <imu>
        <angular_velocity>
          <xacro:imu_noise axis="x" white="${gyro_white[0]}" bias="${gyro_bias[0]}" dyn="${gyro_dyn[0]}" tc="${gyro_tau[0]}"/>
          <xacro:imu_noise axis="y" white="${gyro_white[1]}" bias="${gyro_bias[1]}" dyn="${gyro_dyn[1]}" tc="${gyro_tau[1]}"/>
          <xacro:imu_noise axis="z" white="${gyro_white[2]}" bias="${gyro_bias[2]}" dyn="${gyro_dyn[2]}" tc="${gyro_tau[2]}"/>
        </angular_velocity>
        <linear_acceleration>
          <xacro:imu_noise axis="x" white="${accel_white[0]}" bias="${accel_bias[0]}" dyn="${accel_dyn[0]}" tc="${accel_tau[0]}"/>
          <xacro:imu_noise axis="y" white="${accel_white[1]}" bias="${accel_bias[1]}" dyn="${accel_dyn[1]}" tc="${accel_tau[1]}"/>
          <xacro:imu_noise axis="z" white="${accel_white[2]}" bias="${accel_bias[2]}" dyn="${accel_dyn[2]}" tc="${accel_tau[2]}"/>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <xacro:if value="$(arg imu_clean_reference)">
    <gazebo reference="imu_link">
      <sensor name="imu_clean" type="imu">
        <always_on>true</always_on>
        <update_rate>$(arg imu_update_rate)</update_rate>
        <topic>$(arg imu_clean_topic)</topic>
      </sensor>
    </gazebo>
  </xacro:if>

  <xacro:if value="$(arg camera)">
    <gazebo reference="camera_link">
      <sensor name="camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>/camera/image_raw</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>

  <xacro:steered_wheel name="front_left_wheel" parent="base_link" xyz="${wheel_base_x} ${wheel_track_y} ${axle_height}"/>
  <xacro:steered_wheel name="front_right_wheel" parent="base_link" xyz="${wheel_base_x} ${-wheel_track_y} ${axle_height}"/>
  <xacro:wheel name="rear_left_wheel" parent="base_link" xyz="${-wheel_base_x} ${wheel_track_y} ${axle_height}"/>
  <xacro:wheel name="rear_right_wheel" parent="base_link" xyz="${-wheel_base_x} ${-wheel_track_y} ${axle_height}"/>

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
    <mu1>1.4</mu1>
    <mu2>1.35</mu2>
    <kp>100000.0</kp>
    <kd>25.0</kd>
  </gazebo>

  <gazebo>
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>
    <plugin
      filename="gz-sim-pose-publisher-system"
      name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>true</static_publisher>
      <static_update_frequency>1</static_update_frequency>
    </plugin>
    <plugin
      filename="gz-sim-joint-controller-system"
      name="gz::sim::systems::JointController">
      <joint_name>rear_left_wheel_joint</joint_name>
    </plugin>
    <plugin
      filename="gz-sim-joint-controller-system"
      name="gz::sim::systems::JointController">
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>front_left_wheel_steer_joint</joint_name>
      <topic>/model/rc_car/joint/front_left_wheel_steer_joint/cmd_pos</topic>
      <p_gain>28.0</p_gain>
      <i_gain>0.2</i_gain>
      <d_gain>0.7</d_gain>
      <cmd_max>${steering_limit_rad}</cmd_max>
      <cmd_min>-${steering_limit_rad}</cmd_min>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>front_right_wheel_steer_joint</joint_name>
      <topic>/model/rc_car/joint/front_right_wheel_steer_joint/cmd_pos</topic>
      <p_gain>28.0</p_gain>
      <i_gain>0.2</i_gain>
      <d_gain>0.7</d_gain>
      <cmd_max>${steering_limit_rad}</cmd_max>
      <cmd_min>-${steering_limit_rad}</cmd_min>
    </plugin>
  </gazebo>

  <!-- Real2sim: world pose of base_link at every physics step (the link poses
       of the PosePublisher are relative to the model); the sensor node
       composes both to follow the sprung body that carries the LiDAR. -->
  <xacro:if value="${suspension}">
    <gazebo>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_publish_frequency>1000</odom_publish_frequency>
        <dimensions>3</dimensions>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
